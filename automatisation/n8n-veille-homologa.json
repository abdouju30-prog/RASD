      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 360],
      "parameters": {
        "jsCode": "return [\n  { json: { fichier: 'maj-ephy.yml', nom: 'Registres quotidiens' } },\n  { json: { fichier: 'maj-onssa-regl.yml', nom: 'Textes et listes ONSSA' } },\n  { json: { fichier: 'rapport-hebdo.yml', nom: 'Index ONSSA et rapport PDF' } },\n  { json: { fichier: 'maj-registres-etrangers.yml', nom: 'Registres étrangers' } },\n];"
      }
    },
    {
      "id": "b1a1c0de-0009-4000-8000-000000000009",
