{
  "name": "Homologa — chef d'orchestre de la veille",
  "nodes": [
    {
      "id": "b1a1c0de-0001-4000-8000-000000000001",
      "name": "Jeudi 10h et 1er / 16 du mois",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 10 * * 4" },
            { "field": "cronExpression", "expression": "0 10 1,16 * *" }
          ]
        }
      }
    },
    {
      "id": "b1a1c0de-0002-4000-8000-000000000002",
      "name": "Dernières exécutions GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/abdouju30-prog/homologa/actions/runs?branch=master&per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.GITHUB_HOMOLOGA_TOKEN }}" },
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1a1c0de-0003-4000-8000-000000000003",
      "name": "Bilan par registre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "jsCode": "// Une ligne par tâche GitHub : réussie et à l'heure, ou à relancer.\nconst runs = $input.first().json.workflow_runs || [];\nconst SUIVIS = [\n  { fichier: 'maj-ephy.yml', nom: 'Registres quotidiens (France, Australie, Brésil, Corée)', maxJours: 2 },\n  { fichier: 'maj-onssa-regl.yml', nom: 'Textes et listes ONSSA (jeudi)', maxJours: 8 },\n  { fichier: 'rapport-hebdo.yml', nom: 'Index ONSSA et rapport PDF (jeudi)', maxJours: 8 },\n  { fichier: 'maj-registres-etrangers.yml', nom: 'Registres étrangers (1er et 16 du mois)', maxJours: 17 },\n];\nconst maintenant = Date.now();\nconst lignes = [];\nconst aRelancer = [];\nfor (const s of SUIVIS) {\n  const r = runs.find((x) => (x.path || '').endsWith('/' + s.fichier));\n  if (!r) {\n    lignes.push(`⚪ ${s.nom} : aucune exécution trouvée`);\n    aRelancer.push({ fichier: s.fichier, nom: s.nom });\n    continue;\n  }\n  const debut = Date.parse(r.run_started_at || r.created_at);\n  const jours = Math.floor((maintenant - debut) / 86400000);\n  const date = new Date(debut).toLocaleDateString('fr-FR');\n  if (r.status !== 'completed') {\n    lignes.push(`⏳ ${s.nom} : en cours depuis le ${date}`);\n    continue;\n  }\n  const ok = r.conclusion === 'success';\n  const enRetard = jours > s.maxJours;\n  const etat = ok ? 'réussie' : `échec (${r.conclusion})`;\n  lignes.push(`${ok && !enRetard ? '✅' : '❌'} ${s.nom} : ${etat} le ${date}${enRetard ? ` — rien depuis ${jours} j` : ''}`);\n  if (!ok || enRetard) aRelancer.push({ fichier: s.fichier, nom: s.nom });\n}\nconst message = [\n  'Homologa — bilan de la veille',\n  '',\n  ...lignes,\n  '',\n  aRelancer.length\n    ? `Relance automatique : ${aRelancer.map((s) => s.nom).join(' · ')}`\n    : 'Tout est à jour, rien à relancer.',\n  'Détail : https://github.com/abdouju30-prog/homologa/actions',\n].join('\\n');\nreturn [{ json: { message, aRelancer } }];"
      }
    },
    {
      "id": "b1a1c0de-0004-4000-8000-000000000004",
      "name": "Tâches à relancer",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [720, 120],
      "parameters": {
        "fieldToSplitOut": "aRelancer",
        "options": {}
      }
    },
    {
      "id": "b1a1c0de-0005-4000-8000-000000000005",
      "name": "Relancer sur GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 120],
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/abdouju30-prog/homologa/actions/workflows/{{ $json.fichier }}/dispatches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.GITHUB_HOMOLOGA_TOKEN }}" },
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"ref\": \"master\" }",
        "options": {}
      }
    },
    {
      "id": "b1a1c0de-0006-4000-8000-000000000006",
      "name": "Envoyer le bilan sur Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -120],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_OPS_CHAT_ID, text: $json.message, disable_web_page_preview: true }) }}",
        "options": {}
      }
    },
    {
      "id": "b1a1c0de-0007-4000-8000-000000000007",
      "name": "Tout mettre à jour maintenant",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 360],
      "parameters": {}
    },
    {
      "id": "b1a1c0de-0008-4000-8000-000000000008",
